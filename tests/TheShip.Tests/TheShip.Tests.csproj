<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>TheShip.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TheShip.Core\TheShip.Core.csproj" />
    <ProjectReference Include="..\..\src\TheShip.AI\TheShip.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The music DSP is plain C# (no MonoGame): compiled in here so it can be tested without referencing the Game project. -->
    <Compile Include="..\..\src\TheShip.Game\Music.cs" Link="Music.cs" />
    <Compile Include="..\..\src\TheShip.Game\PcmFeed.cs" Link="PcmFeed.cs" />
  </ItemGroup>

</Project>
