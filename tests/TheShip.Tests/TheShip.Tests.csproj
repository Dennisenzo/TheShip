<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>TheShip.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TheShip.Core\TheShip.Core.csproj" />
    <ProjectReference Include="..\..\src\TheShip.AI\TheShip.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The music DSP is plain C# (no MonoGame): compiled in here so it can be tested without referencing the Game project. -->
    <Compile Include="..\..\src\TheShip.Game\Music.cs" Link="Music.cs" />
    <Compile Include="..\..\src\TheShip.Game\PcmFeed.cs" Link="PcmFeed.cs" />
    <Compile Include="..\..\src\TheShip.Game\LogReveal.cs" Link="LogReveal.cs" />
    <Compile Include="..\..\src\TheShip.Game\TextLayout.cs" Link="TextLayout.cs" />
    <Compile Include="..\..\src\TheShip.Game\CardLayout.cs" Link="CardLayout.cs" />
    <Compile Include="..\..\src\TheShip.Game\Motion.cs" Link="Motion.cs" />
    <Compile Include="..\..\src\TheShip.Game\PixelGrid.cs" Link="PixelGrid.cs" />
    <Compile Include="..\..\src\TheShip.Game\PersonGlyph.cs" Link="PersonGlyph.cs" />
    <Compile Include="..\..\src\TheShip.Game\LineProfile.cs" Link="LineProfile.cs" />
    <Compile Include="..\..\src\TheShip.Game\LogTones.cs" Link="LogTones.cs" />
    <Compile Include="..\..\src\TheShip.Game\StarField.cs" Link="StarField.cs" />
    <Compile Include="..\..\src\TheShip.Game\PlanLayout.cs" Link="PlanLayout.cs" />
  </ItemGroup>

</Project>
